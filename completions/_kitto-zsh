#compdef kit node vault upgrade
# bun is deliberately not claimed here — bun ships its own rich completion
# (~/.bun/_bun) and registering it would clobber that.

local -a subs

case $service in
   upgrade)
      # built-ins plus any user-defined upgrade-<step> functions
      local -a steps=(brew node npm bun claude ${${(k)functions[(I)upgrade-*]}#upgrade-})
      _describe -t steps 'upgrade step' steps
      ;;
   kit)
      subs=(
         'i:scaffold a SvelteKit project here (bunx sv create .)'
         'up:update @sveltejs/kit and the project adapter'
      )
      (( CURRENT == 2 )) && _describe -t subcommands 'kit subcommand' subs
      ;;
   node)
      subs=(
         'upgrade:install latest LTS + latest via fnm, prune the rest'
         'lts:make LTS the fnm default'
         'latest:make latest the fnm default'
      )
      (( CURRENT == 2 )) && _describe -t subcommands 'node subcommand' subs
      _files
      ;;
   vault)
      local -a names
      names=(${(f)"$(vault list 2>/dev/null)"})
      if (( CURRENT == 2 )); then
         subs=(
            'list:show stored secret names'
            'rm:delete a stored secret'
            'export:auto-export an already-stored secret'
            '-n:store a secret without exporting it'
         )
         _describe -t subcommands 'vault subcommand' subs
         (( $#names )) && _describe -t secrets 'stored secret' names
      elif (( CURRENT == 3 )) && [[ $words[2] == (rm|export) ]]; then
         _describe -t secrets 'stored secret' names
      fi
      ;;
esac
