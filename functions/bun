# bun — `up` updates everything, reinstalls from scratch and starts the dev server
emulate -L zsh

if ! (( $+commands[bun] )); then
   echo "kitto-zsh: bun is required (https://bun.sh)" >&2
   return 127
fi

if [[ "$1" == up ]]; then
   command bun update -i --latest
   command rm -rf node_modules
   command rm -f bun.lock
   command bun i
   command bun dev
else
   command bun "$@"
fi
