# bun — `up` updates everything, reinstalls from scratch and starts the dev server
emulate -L zsh

if ! (( $+commands[bun] )); then
   echo "kitto-zsh: bun is required (https://bun.sh)" >&2
   return 127
fi

if [[ "$1" == up ]]; then
   # chained so a failed or cancelled update never wipes the install
   # (bun.lockb is the pre-1.2 binary lockfile — old projects still carry one)
   command bun update -i --latest &&
   command rm -rf node_modules bun.lock bun.lockb &&
   command bun i &&
   command bun dev
else
   command bun "$@"
fi
