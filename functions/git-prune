# git-prune — delete local branches whose upstream is gone
emulate -L zsh

if ! (( $+commands[git] )); then
   echo "kitto-zsh: git is required" >&2
   return 127
fi

# worktreepath is set for the current branch and anything checked out in a
# worktree — git refuses to delete those, so only two-field lines qualify.
# -D because squash-merged branches never look merged to git, yet a gone
# upstream is exactly that case.
git fetch --prune &&
git for-each-ref --format='%(refname:short) %(upstream:track) %(worktreepath)' refs/heads |
   awk '$2 == "[gone]" && NF == 2 {print $1}' | xargs -r git branch -D
