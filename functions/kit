# kit — scaffold or update a SvelteKit project
emulate -L zsh

if ! (( $+commands[bun] )); then
   echo "kitto-zsh: bun is required (https://bun.sh)" >&2
   return 127
fi

case "$1" in
   i)  bunx sv create . ;;
   up)
      # keep whichever adapter the project already uses; adapter-auto for a fresh one
      local adapter
      adapter="$(grep -oE '"@sveltejs/adapter-[a-z0-9-]+"' package.json 2>/dev/null | head -1 | tr -d '"')"
      command bun install -D @sveltejs/kit "${adapter:-@sveltejs/adapter-auto}"
      ;;
   *)  echo "usage: kit i|up" >&2; return 1 ;;
esac
