# upgrade — run every step in KITTO_ZSH_UPGRADE (brew node npm bun claude codex by default)
#
# A step resolves to a user function called upgrade-<step> if one exists, else
# to the built-in of that name. That one rule covers adding a step, reordering,
# and overriding a built-in:
#   upgrade-rust() { rustup update }
#   KITTO_ZSH_UPGRADE=(brew node npm bun claude codex rust)
# Passing step names runs just those: upgrade node bun
emulate -L zsh

local heading=$'\n\033[1;36m→ %s\033[0m\n'

local -a steps=("$@")
(( $#steps )) || steps=("${KITTO_ZSH_UPGRADE[@]}")
(( $#steps )) || steps=(brew node npm bun claude codex)

local name
for name in $steps; do
   if (( $+functions[upgrade-$name] )); then
      printf "$heading" "$name"
      upgrade-$name
      continue
   fi

   case "$name" in
      brew)
         if (( $+commands[brew] )); then
            printf "$heading" "Homebrew"
            brew update && brew upgrade

            printf "$heading" "Homebrew doctor"
            brew doctor   # warnings are informational, so don't stop the run on them

            printf "$heading" "Homebrew cleanup"
            brew cleanup
         else
            printf "$heading" "Homebrew (skipped — not installed)"
         fi
         ;;
      node)
         if (( $+functions[node] )); then
            printf "$heading" "Node"
            node upgrade   # installs fnm on first run if it's missing
         else
            printf "$heading" "Node (skipped)"
         fi
         ;;
      npm)
         if (( $+commands[npm] )); then
            printf "$heading" "npm"
            npm i npm -g
         else
            printf "$heading" "npm (skipped — not installed)"
         fi
         ;;
      bun)
         if (( $+commands[bun] )); then
            printf "$heading" "Bun"
            command bun upgrade
         else
            printf "$heading" "Bun (skipped — not installed)"
         fi
         ;;
      claude)
         if (( $+commands[claude] )); then
            printf "$heading" "Claude Code"
            claude update
         else
            printf "$heading" "Claude Code (skipped — not installed)"
         fi
         ;;
      codex)
         if (( $+commands[codex] )); then
            printf "$heading" "Codex"
            codex update
         else
            printf "$heading" "Codex (skipped — not installed)"
         fi
         ;;
      *)
         printf "$heading" "$name (skipped — no built-in step or upgrade-$name function)"
         ;;
   esac
done

printf "$heading" "All up to date"
